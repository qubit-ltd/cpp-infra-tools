{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "bundle_id": {
      "type": "string"
    },
    "protocol_major": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "protocol": {
            "const": 1
          },
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "executable_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "binary": {
                  "type": "string"
                },
                "format": {
                  "enum": [
                    "raw",
                    "tar.gz",
                    "zip"
                  ]
                }
              },
              "required": [
                "url",
                "sha256",
                "executable_sha256",
                "binary"
              ]
            }
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  },
                  "executable_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cargo_lock_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  }
                },
                "required": [
                  "url",
                  "sha256",
                  "cargo_lock_sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "version",
          "revision",
          "protocol",
          "assets"
        ]
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "owner",
          "url",
          "sha256"
        ]
      }
    },
    "external_tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "program": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "program",
          "version"
        ]
      }
    },
    "catalog_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "bundle_id",
    "protocol_major",
    "tools"
  ]
}
